# Copiar a .env. Usar un proyecto Supabase exclusivo para desarrollo.
APP_PORT=5173
VITE_USE_POLLING=true

# PUBLICAS: se entregan al navegador. Pueden quedar vacias para revisar la UI.
# En Vercel agregarlas en Settings > Environment Variables antes de compilar.
# Se admite sb_publishable_... o la clave legacy anon (JWT), nunca service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PRIVADAS: solo las recibe el contenedor PostgreSQL local.
# Sustituir antes del primer inicio; no reutilizar una clave de produccion.
POSTGRES_DB=cocteles
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_por_una_clave_local_larga
POSTGRES_PORT=54322

# Nunca agregar service_role, claves secretas ni passwords con prefijo VITE_.
